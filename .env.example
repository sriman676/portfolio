# Copy to .env.local (never commit .env*). Generate values in Phase 13 with scripts/make-secrets.mjs.

# Upstash Redis (edit-mode storage). Vercel's Upstash integration may inject KV_REST_API_* instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SHA-256 hex of the normalized edit-mode trigger word (NFKC, trimmed, lowercase). Obscurity only, NOT the security boundary
NEXT_PUBLIC_EDIT_TRIGGER_HASH=

# Argon2id hash of the edit passphrase, PHC format: $argon2id$v=19$m=...,t=...,p=...$<salt>$<hash>  (server-only)
EDITOR_PASSPHRASE_HASH=

# 32+ random bytes, hex. Signs the edit-session cookie. (server-only)
SESSION_SECRET=

# Base32 TOTP secret for edit-mode 2FA (server-only)
EDITOR_TOTP_SECRET=
# Comma-separated Argon2id hashes of one-time recovery codes (server-only)
EDITOR_RECOVERY_HASHES=

# Canonical site URL, e.g. https://srimanrutvik.dev
NEXT_PUBLIC_SITE_URL=

# Optional, server-only: read-only token to raise GitHub API limits (sync works without it)
GITHUB_TOKEN=
